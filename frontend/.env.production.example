# Production defaults (same-origin)
# When deployed as a single service (FastAPI serving the static export),
# the frontend will use `/api` and derive the WebSocket host from the current URL.
#
# If you deploy the backend separately, set these in your platform env:
# NEXT_PUBLIC_BACKEND_URL=https://your-backend.example.com
# NEXT_PUBLIC_WS_URL=wss://your-backend.example.com

# Supabase (browser-safe keys)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# OAuth redirect used by the app after Google login (must be allowed in Supabase Auth URL settings)
# NEXT_PUBLIC_AUTH_REDIRECT_URL=https://your-frontend.example.com/auth/callback
