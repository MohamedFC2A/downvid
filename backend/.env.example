# Server Configuration
PORT=8000
HOST=0.0.0.0
NODE_ENV=production

# Security
# Generate a secret key: openssl rand -hex 32
SECRET_KEY=your_secret_key_here

# External Services
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# RapidAPI (social-download-all-in-one)
# Use this provider to avoid YouTube cookie / anti-bot challenges.
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=social-download-all-in-one.p.rapidapi.com
RAPIDAPI_SNAP_HOST=snap-video3.p.rapidapi.com

# Download provider: ytdlp | rapidapi
DOWNLOAD_PROVIDER=ytdlp

# Paths (Optional overrides)
# FRONTEND_PATH=/app/frontend/out
# DOWNLOADS_DIR=/app/downloads

# Supabase (Subscriptions / Auth)
# Create a Supabase project and run `backend/supabase/schema.sql` in the SQL editor.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
# JWT secret from Supabase Project Settings -> API -> JWT Secret
SUPABASE_JWT_SECRET=your_jwt_secret_here
